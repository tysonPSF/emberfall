# systemd unit for the Emberfall server. Install with:
#   sudo cp tools/server/emberfall.service /etc/systemd/system/
#   (edit User, WorkingDirectory and GODOT below)
#   sudo systemctl enable --now emberfall
# Updates: emberfall-update.timer pulls main and has the server restart itself
# (docs/server-updates.md); by hand: git pull, then sudo systemctl restart emberfall
# Logs: journalctl -u emberfall -f

[Unit]
Description=Emberfall game server
After=network-online.target

[Service]
User=emberfall
WorkingDirectory=/home/emberfall/emberfall
Environment=GODOT=/usr/local/bin/godot
Environment=PORT=7777
Environment=DATA=/home/emberfall/emberfall-data
ExecStart=/home/emberfall/emberfall/tools/server/run_server.sh
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
